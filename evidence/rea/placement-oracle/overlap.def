VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN road_demo ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 12000 8000 ) ;
ROW row0 rustroad_site 1000 1000 N DO 20 BY 1 STEP 500 0 ;
ROW row1 rustroad_site 1000 2000 N DO 20 BY 1 STEP 500 0 ;
ROW row2 rustroad_site 1000 3000 N DO 20 BY 1 STEP 500 0 ;
ROW row3 rustroad_site 1000 4000 N DO 20 BY 1 STEP 500 0 ;
ROW row4 rustroad_site 1000 5000 N DO 20 BY 1 STEP 500 0 ;
ROW row5 rustroad_site 1000 6000 N DO 20 BY 1 STEP 500 0 ;
COMPONENTS 24 ;
- u0 CELL4 + PLACED ( 1000 1000 ) N ;
- u1 CELL2 + PLACED ( 1000 1000 ) N ;
- u2 CELL1 + PLACED ( 4000 1000 ) N ;
- u3 CELL4 + PLACED ( 4500 1000 ) N ;
- u4 CELL2 + PLACED ( 6500 1000 ) N ;
- u5 CELL1 + PLACED ( 7500 1000 ) N ;
- u6 CELL4 + PLACED ( 8000 1000 ) N ;
- u7 CELL2 + PLACED ( 10000 1000 ) N ;
- u8 CELL1 + PLACED ( 1000 2000 ) N ;
- u9 CELL4 + PLACED ( 1500 2000 ) N ;
- u10 CELL2 + PLACED ( 3500 2000 ) N ;
- u11 CELL1 + PLACED ( 4500 2000 ) N ;
- u12 CELL4 + PLACED ( 5000 2000 ) N ;
- u13 CELL2 + PLACED ( 7000 2000 ) N ;
- u14 CELL1 + PLACED ( 8000 2000 ) N ;
- u15 CELL4 + PLACED ( 8500 2000 ) N ;
- u16 CELL2 + PLACED ( 1000 3000 ) N ;
- u17 CELL1 + PLACED ( 2000 3000 ) N ;
- u18 CELL4 + PLACED ( 2500 3000 ) N ;
- u19 CELL2 + PLACED ( 4500 3000 ) N ;
- u20 CELL1 + PLACED ( 5500 3000 ) N ;
- u21 CELL4 + PLACED ( 6000 3000 ) N ;
- u22 CELL2 + PLACED ( 8000 3000 ) N ;
- u23 CELL1 + PLACED ( 9000 3000 ) N ;
END COMPONENTS
END DESIGN
