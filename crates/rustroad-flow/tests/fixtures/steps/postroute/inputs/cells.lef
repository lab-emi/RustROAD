VERSION 5.8 ;
MACRO BUFX1
  CLASS CORE ;
  SIZE 1.44 BY 3.33 ;
  PIN A
    DIRECTION INPUT ;
  END A
END BUFX1
MACRO BUFX2
  SIZE 1.44 BY 3.33 ;
END BUFX2
MACRO BUFX4
  FOREIGN BUFX4 ;
  SIZE   1.440   BY   3.330 ;
END BUFX4
MACRO BUFX8
  SIZE 2.88 BY 3.33 ;
END BUFX8
MACRO INVX1
  SIZE 0.9605 BY 3.33 ;
