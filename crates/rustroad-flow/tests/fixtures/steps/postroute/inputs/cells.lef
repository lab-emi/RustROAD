MACRO FILL1
  CLASS CORE SPACER ;
  SIZE 0.48 BY 3.33 ;
  PIN VDD
    DIRECTION INOUT ;
    USE POWER ;
  END VDD
  PIN VSS
    USE GROUND ;
  END VSS
END FILL1
MACRO FILL2
  SIZE 0.96 BY 3.33 ;

  PIN VDD
    USE POWER ;
  END VDD

  PIN VSS
    USE  GROUND  ;
  END VSS
END FILL2
MACRO TAP
  SIZE 0.96 BY 3.33 ;
  PIN VDD
    USE POWER ;
  END VDD
  PIN SUB
    USE SIGNAL ;
  END SUB
END TAP
MACRO EMPTY
  SIZE 0.96 BY 3.33 ;
END EMPTY
